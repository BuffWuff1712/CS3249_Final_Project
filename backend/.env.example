OPENAI_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=your_model_name_here
OPENAI_REASONING_EFFORT=medium
BEANY_LLM_MODE=openai
BEANY_DB=data/beany.sqlite3
BEANY_RESEARCH_KEY=
FRONTEND_ORIGIN=http://localhost:3000

#browser_use or catalogue
BEANY_SEARCH_PROVIDER=catalogue 
BROWSER_USE_API_KEY=your_key_here

# Replace with the actual retailer domains you want searched:
BROWSER_USE_ALLOWED_DOMAINS=retailer-one.com,retailer-two.com

BROWSER_USE_TIMEOUT_SECONDS=120
BROWSER_USE_MAX_COST_USD=0.5

# Optional: replay saved study listings instead of searching the web (no Browser Use key needed)
# BROWSER_USE_REPLAY=data/replay/study_listings.json