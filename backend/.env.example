# Copy to backend/.env (git-ignored) and fill in locally. Never put keys in frontend env files.

# --- Conversation model (any OpenAI-compatible HTTPS endpoint) ---
# NUS SoCLaaS (default). Responses API with schema-constrained output.
OPENAI_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=your_model_name_here
OPENAI_API_MODE=responses
OPENAI_STRUCTURED_MODE=schema
# Leave blank unless the model accepts a reasoning effort (DeepSeek rejects it).
OPENAI_REASONING_EFFORT=

# DeepSeek instead: Chat Completions with JSON mode. Use a model listed by
# `python -m app.check_gateway` (for example deepseek-flash).
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-flash
# OPENAI_API_MODE=chat
# OPENAI_STRUCTURED_MODE=json
# If JSON mode is rejected, use OPENAI_STRUCTURED_MODE=text.

# openai = use the model above; mock = offline test double (visibly labelled).
BEANY_LLM_MODE=openai

# --- App ---
BEANY_DB=data/beany.sqlite3
# Key for the /research study workspace. Leave blank to disable researcher routes.
BEANY_RESEARCH_KEY=
FRONTEND_ORIGIN=http://localhost:3000

# --- Product search ---
# catalogue = fictional local catalogue; browser_use = live web listings (or replay, below).
# Saved per session: click "Fresh session" after changing it.
BEANY_SEARCH_PROVIDER=catalogue
# Who finds merchant-risk signals in local products: rules (default) or ai.
# ai sends each proposed offer's shopper-visible evidence to the configured model; rules is the fallback.
BEANY_RISK_DETECTION=rules

# Browser Use Cloud (only used when BEANY_SEARCH_PROVIDER=browser_use and replay is off).
BROWSER_USE_API_KEY=your_key_here
# Public retailer hostnames only: no https:// or paths, e.g. amazon.sg,decathlon.sg
BROWSER_USE_ALLOWED_DOMAINS=retailer-one.com,retailer-two.com
# Per run. Each run also opens seller and return-policy pages, so allow time and budget.
BROWSER_USE_TIMEOUT_SECONDS=240
BROWSER_USE_MAX_COST_USD=1
# Optional: a model supported by your Browser Use account (blank = provider default).
# BROWSER_USE_MODEL=

# Optional: replay saved study listings instead of searching the web. Needs
# BEANY_SEARCH_PROVIDER=browser_use; no Browser Use key or credits are used.
# BROWSER_USE_REPLAY=data/replay/study_listings.json
